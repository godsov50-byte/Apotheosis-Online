{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apotheosis.online/contracts/v1/clarification.request.schema.json",
  "title": "AO Clarification Request",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/requestEnvelope"
    }
  ],
  "properties": {
    "request_type": {
      "const": "clarification"
    },
    "payload": {
      "type": "object",
      "required": [
        "original_request_id",
        "answer"
      ],
      "properties": {
        "original_request_id": {
          "type": "string"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "selected_entity_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
