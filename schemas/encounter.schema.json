{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AO Encounter Record",
  "description": "Provisional Layer 12 encounter schema. Proposal only; not canon or production runtime authority.",
  "type": "object",
  "required": ["id", "source", "state", "scale", "composition", "objectives", "environment", "deployment", "persistence", "history"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "type": {"type":"string"},
    "source": {"type":"object","required":["kind"],"properties":{"kind":{"type":"string"},"originId":{"type":["string","null"]},"evidenceRefs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "state": {"enum":["dormant","candidate","evaluating","registered","preparing","active","escalating","paused","suspended","resolved","failed","terminated","persisting"]},
    "scale": {"enum":["individual","pair_skirmish","group","army_battle","siege_strategic"]},
    "location": {"type":"object","properties":{"regionId":{"type":["string","null"]},"chunkId":{"type":["string","null"]},"battlefieldId":{"type":["string","null"]},"spatialBounds":{"type":["object","null"]},"deploymentZones":{"type":"array","items":{"$ref":"#/$defs/deploymentZone"}},"additionalProperties":true},
    "composition": {"type":"object","required":["participants"],"properties":{"participants":{"type":"array","items":{"$ref":"#/$defs/participantRef"}},"roles":{"type":"array","items":{"type":"object"}},"factions":{"type":"array","items":{"type":"string"}},"populationSources":{"type":"array","items":{"type":"string"}},"existingEntityRefs":{"type":"array","items":{"type":"string"}},"summonedEntityRefs":{"type":"array","items":{"type":"string"}},"generatedEntityRefs":{"type":"array","items":{"type":"string"}},"reserves":{"type":"array","items":{"$ref":"#/$defs/reinforcement"}}},"additionalProperties":true},
    "objectives": {"type":"object","properties":{"primary":{"type":"array","items":{"$ref":"#/$defs/objective"}},"secondary":{"type":"array","items":{"$ref":"#/$defs/objective"}},"hidden":{"type":"array","items":{"$ref":"#/$defs/objective"}}},"additionalProperties":true},
    "environment": {"type":"object","properties":{"terrainRefs":{"type":"array","items":{"type":"string"}},"hazards":{"type":"array","items":{"type":"object"}},"conditions":{"type":"array","items":{"type":"object"}},"weather":{"type":["object","null"]},"structureRefs":{"type":"array","items":{"type":"string"}},"resourceRefs":{"type":"array","items":{"type":"string"}},"spatialStateVersion":{"type":"integer","minimum":0}},"additionalProperties":true},
    "difficulty": {"type":"object","properties":{"estimatedLevel":{"enum":["trivial","easy","moderate","challenging","severe","overwhelming","unknown"]},"factors":{"type":"array","items":{"type":"string"}},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"assessmentTarget":{"type":["string","null"]},"assessmentTimestamp":{"type":["string","null"],"format":"date-time"}},"additionalProperties":true},
    "deployment": {"type":"object","properties":{"entries":{"type":"array","items":{"type":"object"}},"spawnRules":{"type":"array","items":{"type":"object"}},"deploymentRules":{"type":"array","items":{"type":"object"}},"protections":{"type":"array","items":{"type":"object"}},"reserveRefs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "reinforcement": {"type":"object","properties":{"enabled":{"type":"boolean"},"sources":{"type":"array","items":{"type":"string"}},"triggerRules":{"type":"array","items":{"type":"object"}},"mobilization":{"type":"array","items":{"type":"object"}},"travelRoutes":{"type":"array","items":{"type":"object"}},"pending":{"type":"array","items":{"$ref":"#/$defs/reinforcement"}}},"additionalProperties":true},
    "waves": {"type":"object","properties":{"enabled":{"type":"boolean"},"structure":{"enum":["sequential","timed","conditional","reinforcement","escalating","mixed","endless","survival","boss_support",null]},"currentWave":{"type":["integer","null"],"minimum":0},"definitions":{"type":"array","items":{"type":"object"}},"transitionRules":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "ecology": {"type":"object","properties":{"populationRefs":{"type":"array","items":{"type":"string"}},"habitatState":{"type":["object","null"]},"territorialState":{"type":["object","null"]},"populationChanges":{"type":"array","items":{"type":"object"}},"migration":{"type":"array","items":{"type":"object"}},"regenerationRules":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "director": {"type":"object","properties":{"adaptiveSelection":{"type":"boolean"},"allowedParameters":{"type":"array","items":{"type":"string"}},"prohibitedAdjustments":{"type":"array","items":{"type":"string"}},"decisionHistory":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "combat": {"type":"object","properties":{"round":{"type":"integer","minimum":0},"activeEntityRefs":{"type":"array","items":{"type":"string"}},"defeatedEntityRefs":{"type":"array","items":{"type":"string"}},"withdrawnEntityRefs":{"type":"array","items":{"type":"string"}},"capturedEntityRefs":{"type":"array","items":{"type":"string"}},"actionHistory":{"type":"array","items":{"type":"object"}},"reactions":{"type":"array","items":{"type":"object"}},"events":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "persistence": {"type":"object","properties":{"continueWhenAbsent":{"type":"boolean"},"suspensionRules":{"type":"array","items":{"type":"object"}},"reentryRules":{"type":"array","items":{"type":"object"}},"persistentEffects":{"type":"array","items":{"type":"string"}},"worldChanges":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "rewards": {"type":"object","properties":{"sources":{"type":"array","items":{"type":"string"}},"outcomes":{"type":"array","items":{"type":"object"}},"eligibleRewards":{"type":"array","items":{"type":"object"}},"committedRewards":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "resolution": {"type":"object","properties":{"outcome":{"enum":["victory","defeat","partial_victory","partial_defeat","draw","retreat","escape","surrender","capture","stalemate","interrupted",null]},"conditionsMet":{"type":"array","items":{"type":"string"}},"conditionsFailed":{"type":"array","items":{"type":"string"}},"unresolved":{"type":"array","items":{"type":"string"}},"resolvedAt":{"type":["string","null"],"format":"date-time"}},"additionalProperties":true},
    "history": {"type":"object","properties":{"eventLedger":{"type":"array","items":{"$ref":"#/$defs/event"}},"stateVersion":{"type":"integer","minimum":0}},"additionalProperties":true}
  },
  "$defs": {
    "participantRef": {"type":"object","required":["entityId","sourceKind"],"properties":{"entityId":{"type":"string","minLength":1},"sourceKind":{"enum":["existing","population","summoned","generated","reinforcement"]},"side":{"type":["string","null"]},"role":{"type":["string","null"]},"deployment":{"type":["object","null"]}},"additionalProperties":true},
    "deploymentZone": {"type":"object","required":["id","kind"],"properties":{"id":{"type":"string"},"kind":{"enum":["player_entry","enemy_entry","neutral","reserve","objective","hazard","restricted","concealed"]},"cells":{"type":"array","items":{"type":"object","required":["x","y"],"properties":{"x":{"type":"integer"},"y":{"type":"integer"},"z":{"type":"integer"}}}},"hiddenFromParticipants":{"type":"boolean"}},"additionalProperties":true},
    "objective": {"type":"object","required":["id","type","state"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"state":{"enum":["hidden","unknown","available","discovered","active","contested","progressing","paused","completed","failed","destroyed","expired"]},"visible":{"type":"boolean"},"conditions":{"type":"array","items":{"type":"object"}},"progress":{"type":["object","number","null"]},"targetRefs":{"type":"array","items":{"type":"string"}},"rulesRef":{"type":["string","null"]}},"additionalProperties":true},
    "reinforcement": {"type":"object","required":["id","sourceRef","trigger","state"],"properties":{"id":{"type":"string"},"sourceRef":{"type":"string"},"trigger":{"type":"object"},"state":{"enum":["pending","mobilizing","traveling","arrived","deployed","cancelled"]},"travelTicks":{"type":"integer","minimum":0},"arrivalTick":{"type":["integer","null"],"minimum":0},"routeRef":{"type":["string","null"]},"entityRefs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "event": {"type":"object","required":["id","type","timestamp"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"timestamp":{"type":"string","format":"date-time"},"sourceRef":{"type":["string","null"]},"triggerRef":{"type":["string","null"]},"participantRefs":{"type":"array","items":{"type":"string"}},"causalRefs":{"type":"array","items":{"type":"string"}},"payload":{"type":"object"}},"additionalProperties":true}
  }
}
